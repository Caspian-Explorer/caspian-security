{
  "name": "caspian-security",
  "displayName": "Caspian Security",
  "description": "Security scanner for VS Code AND a standalone `caspian` CLI you can run anywhere (PowerShell/cmd/bash, no VS Code needed) — 299 rules covering code and infrastructure (Dockerfile, Terraform, Kubernetes), intra-file taint tracking, SSRF/XXE/SSTI/deserialization/JWT/OAuth/LDAP, 29 provider-prefix secret detectors, git-history scanner, opt-in OSV.dev multi-ecosystem dependency check (Python, Go, Rust, Java, Ruby, PHP), AI fixes, MCP server + one-command AI-agent integration (Claude Code, Cursor, Antigravity), hardened webview, reusable GitHub Action with SARIF upload, Open VSX release",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Caspian-Explorer/caspian-security"
  },
  "version": "10.11.1",
  "publisher": "CaspianTools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "keywords": [
    "security",
    "vulnerability",
    "linting",
    "code-analysis",
    "static-analysis",
    "owasp",
    "xss",
    "sql-injection",
    "csrf"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:csharp",
    "onLanguage:php",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:kotlin",
    "onLanguage:yaml",
    "onLanguage:terraform",
    "onLanguage:dockerfile"
  ],
  "main": "./out/extension.js",
  "bin": {
    "caspian-security": "out/cli/caspian.js",
    "caspian": "out/cli/caspian.js",
    "caspian-scan": "out/cli/scan.js",
    "caspian-git-history-scan": "out/cli/gitHistoryScan.js",
    "caspian-check-updates": "out/cli/checkUpdates.js",
    "caspian-mcp": "out/cli/mcpServer.js"
  },
  "files": [
    "out/",
    "icon.png",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THREAT_MODEL.md",
    "SECURITY.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "caspian-security.copyAgentInstructions",
        "title": "Caspian Security: Copy AI Agent Instructions (CLAUDE.md / Cursor / Antigravity)"
      },
      {
        "command": "caspian-security.copyMcpConfig",
        "title": "Caspian Security: Copy MCP Server Config"
      },
      {
        "command": "caspian-security.runCheck",
        "title": "Run Security Check"
      },
      {
        "command": "caspian-security.runCheckFile",
        "title": "Caspian Security: Check Current File"
      },
      {
        "command": "caspian-security.runCheckWorkspace",
        "title": "Caspian Security: Check Entire Workspace"
      },
      {
        "command": "caspian-security.runFullScan",
        "title": "Caspian Security: Run Full Security Scan (All Categories)"
      },
      {
        "command": "caspian-security.fixIssue",
        "title": "Caspian Security: Fix Issue (AI or Suggestion)"
      },
      {
        "command": "caspian-security.openAISettings",
        "title": "Caspian Security: Configure AI Fix Provider"
      },
      {
        "command": "caspian-security.aiFixIssue",
        "title": "Caspian Security: Fix Issue with AI"
      },
      {
        "command": "caspian-security.ignoreIssue",
        "title": "Caspian Security: Ignore Issue"
      },
      {
        "command": "caspian-security.ignoreAllByRule",
        "title": "Caspian Security: Ignore All Issues by Rule"
      },
      {
        "command": "caspian-security.resetFixTracker",
        "title": "Caspian Security: Reset Fix Tracker"
      },
      {
        "command": "caspian-security.verifyIssue",
        "title": "Caspian Security: Verify Issue Resolution"
      },
      {
        "command": "caspian-security.verifyAllFixes",
        "title": "Caspian Security: Verify All Fixes"
      },
      {
        "command": "caspian-security.check-auth-access-control",
        "title": "Caspian Security: Check Authentication & Access Control"
      },
      {
        "command": "caspian-security.check-input-validation-xss",
        "title": "Caspian Security: Check Input Validation & XSS"
      },
      {
        "command": "caspian-security.check-csrf-protection",
        "title": "Caspian Security: Check CSRF Protection"
      },
      {
        "command": "caspian-security.check-cors-configuration",
        "title": "Caspian Security: Check CORS Configuration"
      },
      {
        "command": "caspian-security.check-encryption-data-protection",
        "title": "Caspian Security: Check Encryption & Data Protection"
      },
      {
        "command": "caspian-security.check-api-security",
        "title": "Caspian Security: Check API Security"
      },
      {
        "command": "caspian-security.check-database-security",
        "title": "Caspian Security: Check Database Security"
      },
      {
        "command": "caspian-security.check-file-handling",
        "title": "Caspian Security: Check File Handling"
      },
      {
        "command": "caspian-security.check-secrets-credentials",
        "title": "Caspian Security: Check Secrets & Credentials"
      },
      {
        "command": "caspian-security.check-frontend-security",
        "title": "Caspian Security: Check Frontend Security"
      },
      {
        "command": "caspian-security.check-business-logic-payment",
        "title": "Caspian Security: Check Business Logic & Payment Security"
      },
      {
        "command": "caspian-security.check-logging-monitoring",
        "title": "Caspian Security: Check Logging & Monitoring"
      },
      {
        "command": "caspian-security.check-dependencies-supply-chain",
        "title": "Caspian Security: Check Dependencies & Supply Chain"
      },
      {
        "command": "caspian-security.check-infrastructure-deployment",
        "title": "Caspian Security: Check Infrastructure & Deployment"
      },
      {
        "command": "caspian-security.showResultsPanel",
        "title": "Caspian Security: Show Results Panel"
      },
      {
        "command": "caspian-security.exportJSON",
        "title": "Caspian Security: Export Results to JSON"
      },
      {
        "command": "caspian-security.exportCSV",
        "title": "Caspian Security: Export Results to CSV"
      },
      {
        "command": "caspian-security.exportSARIF",
        "title": "Caspian Security: Export Results to SARIF"
      },
      {
        "command": "caspian-security.runCheckUncommitted",
        "title": "Caspian Security: Scan Uncommitted Files"
      },
      {
        "command": "caspian-security.checkDependencyUpdates",
        "title": "Caspian Security: Check Dependency & Stack Updates"
      },
      {
        "command": "caspian-security.markFalsePositive",
        "title": "Caspian Security: Mark as False Positive"
      },
      {
        "command": "caspian-security.showScanHistory",
        "title": "Caspian Security: Show Scan History"
      },
      {
        "command": "caspian-security.clearFalsePositives",
        "title": "Caspian Security: Clear All False Positive Dismissals"
      },
      {
        "command": "caspian-security.showLearningDashboard",
        "title": "Caspian Security: Show Learning Dashboard"
      },
      {
        "command": "caspian-security.resetLearningData",
        "title": "Caspian Security: Reset All Learning Data"
      },
      {
        "command": "caspian-security.exportLearningData",
        "title": "Caspian Security: Export Learning Data"
      },
      {
        "command": "caspian-security.previewTelemetryData",
        "title": "Caspian Security: Preview Telemetry Data"
      },
      {
        "command": "caspian-security.showTaskDashboard",
        "title": "Caspian Security: Show Security Tasks"
      },
      {
        "command": "caspian-security.refreshTasks",
        "title": "Caspian Security: Refresh Security Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "caspian-security.taskAction",
        "title": "Caspian Security: Task Action"
      },
      {
        "command": "caspian-security.completeAllOverdue",
        "title": "Caspian Security: Complete All Overdue Tasks"
      },
      {
        "command": "caspian-security.showTaskDetail",
        "title": "Caspian Security: Show Task Detail"
      },
      {
        "command": "caspian-security.showWelcome",
        "title": "Caspian Security: Welcome"
      },
      {
        "command": "caspian-security.showSecurityScore",
        "title": "Caspian Security: Show Security Score"
      },
      {
        "command": "caspian-security.triageSession",
        "title": "Caspian Security: Start Triage Session"
      },
      {
        "command": "caspian-security.scanBranchChanges",
        "title": "Caspian Security: Scan Branch Changes (PR Scope)"
      },
      {
        "command": "caspian-security.explainRule",
        "title": "Caspian Security: Explain Rule"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "caspian-security",
          "title": "Caspian Security",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "caspian-security": [
        {
          "id": "caspianSecurityTasks",
          "name": "Security Tasks",
          "type": "webview",
          "when": "caspianSecurity.taskManagementEnabled"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "caspian-security.refreshTasks",
          "when": "view == caspianSecurityTasks",
          "group": "navigation"
        },
        {
          "command": "caspian-security.completeAllOverdue",
          "when": "view == caspianSecurityTasks"
        }
      ],
      "scm/title": [
        {
          "command": "caspian-security.runCheckUncommitted",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "commandPalette": [
        {
          "command": "caspian-security.exportJSON",
          "when": "caspian-security.hasResults"
        },
        {
          "command": "caspian-security.exportCSV",
          "when": "caspian-security.hasResults"
        },
        {
          "command": "caspian-security.exportSARIF",
          "when": "caspian-security.hasResults"
        },
        {
          "command": "caspian-security.aiFixIssue",
          "when": "false"
        },
        {
          "command": "caspian-security.ignoreIssue",
          "when": "false"
        },
        {
          "command": "caspian-security.verifyIssue",
          "when": "false"
        },
        {
          "command": "caspian-security.verifyAllFixes",
          "when": "caspian-security.hasResults"
        },
        {
          "command": "caspian-security.markFalsePositive",
          "when": "false"
        },
        {
          "command": "caspian-security.taskAction",
          "when": "false"
        },
        {
          "command": "caspian-security.showTaskDetail",
          "when": "false"
        },
        {
          "command": "caspian-security.ignoreAllByRule",
          "when": "false"
        },
        {
          "command": "caspian-security.explainRule",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Caspian Security",
      "properties": {
        "caspianSecurity.autoCheck": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run security checks as you type"
        },
        "caspianSecurity.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run security checks when files are saved"
        },
        "caspianSecurity.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "default": "warning",
          "description": "Minimum severity level to report"
        },
        "caspianSecurity.enabledLanguages": {
          "type": "array",
          "default": [
            "javascript",
            "typescript",
            "python",
            "java",
            "csharp",
            "php",
            "go",
            "rust",
            "kotlin",
            "yaml",
            "terraform",
            "dockerfile"
          ],
          "description": "Languages to check (yaml covers Kubernetes manifests; dockerfile covers Dockerfile/Containerfile)"
        },
        "caspianSecurity.enableAuthAccessControl": {
          "type": "boolean",
          "default": true,
          "description": "Enable Authentication & Access Control checks"
        },
        "caspianSecurity.enableInputValidationXss": {
          "type": "boolean",
          "default": true,
          "description": "Enable Input Validation & XSS checks"
        },
        "caspianSecurity.enableCsrfProtection": {
          "type": "boolean",
          "default": true,
          "description": "Enable CSRF Protection checks"
        },
        "caspianSecurity.enableCorsConfiguration": {
          "type": "boolean",
          "default": true,
          "description": "Enable CORS Configuration checks"
        },
        "caspianSecurity.enableEncryptionDataProtection": {
          "type": "boolean",
          "default": true,
          "description": "Enable Encryption & Data Protection checks"
        },
        "caspianSecurity.enableApiSecurity": {
          "type": "boolean",
          "default": true,
          "description": "Enable API Security checks"
        },
        "caspianSecurity.enableDatabaseSecurity": {
          "type": "boolean",
          "default": true,
          "description": "Enable Database Security checks"
        },
        "caspianSecurity.enableFileHandling": {
          "type": "boolean",
          "default": true,
          "description": "Enable File Handling checks"
        },
        "caspianSecurity.enableSecretsCredentials": {
          "type": "boolean",
          "default": true,
          "description": "Enable Secrets & Credentials checks"
        },
        "caspianSecurity.enableFrontendSecurity": {
          "type": "boolean",
          "default": true,
          "description": "Enable Frontend Security checks"
        },
        "caspianSecurity.enableBusinessLogicPayment": {
          "type": "boolean",
          "default": true,
          "description": "Enable Business Logic & Payment Security checks"
        },
        "caspianSecurity.enableLoggingMonitoring": {
          "type": "boolean",
          "default": true,
          "description": "Enable Logging & Monitoring checks"
        },
        "caspianSecurity.enableDependenciesSupplyChain": {
          "type": "boolean",
          "default": true,
          "description": "Enable Dependencies & Supply Chain checks"
        },
        "caspianSecurity.enableInfrastructureDeployment": {
          "type": "boolean",
          "default": true,
          "description": "Enable Infrastructure & Deployment checks"
        },
        "caspianSecurity.includeDependencyCheck": {
          "type": "boolean",
          "default": true,
          "description": "Include dependency update and vulnerability checks during workspace scans"
        },
        "caspianSecurity.osvCheck": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in: during dependency checks, also query the OSV.dev vulnerability database for non-npm manifests (requirements.txt, go.mod, Cargo.lock/Cargo.toml, pom.xml, Gemfile.lock, composer.lock). Privacy: sends dependency names and versions — never your code — to the public api.osv.dev API."
        },
        "caspianSecurity.autoVerify": {
          "type": "boolean",
          "default": true,
          "description": "Automatically verify findings as resolved when they disappear from scan results"
        },
        "caspianSecurity.aiProvider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "gemini"
          ],
          "default": "anthropic",
          "description": "AI provider for security fix generation",
          "enumDescriptions": [
            "Anthropic Claude (recommended)",
            "OpenAI GPT-4",
            "Google Gemini"
          ]
        },
        "caspianSecurity.showInformational": {
          "type": "boolean",
          "default": true,
          "description": "Show informational reminders alongside security findings. Disable to see only actionable security issues."
        },
        "caspianSecurity.reduceInternalPathSeverity": {
          "type": "boolean",
          "default": true,
          "description": "Reduce severity for files in admin, scripts, internal, and seed directories"
        },
        "caspianSecurity.skipGeneratedFiles": {
          "type": "boolean",
          "default": true,
          "description": "Skip scanning auto-generated and minified files (detected by @generated markers, file patterns, or minification heuristics)"
        },
        "caspianSecurity.maxFileSize": {
          "type": "number",
          "default": 500000,
          "description": "Maximum file size in characters to scan. Files larger than this are skipped to prevent high CPU usage. Set to 0 to disable the limit."
        },
        "caspianSecurity.aiModel": {
          "type": "string",
          "default": "",
          "description": "Optional model override (leave empty for provider default: Claude claude-sonnet-4-20250514, OpenAI gpt-4o, Gemini gemini-2.0-flash)"
        },
        "caspianSecurity.aiFixMinimalContext": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, AI fixes send only the ~20 lines surrounding the finding to the provider instead of the whole file. Safer default — your full file contents never leave your workspace. Disable for complex fixes that need cross-file awareness."
        },
        "caspianSecurity.aiFixRequireConsent": {
          "type": "boolean",
          "default": true,
          "description": "Show a confirmation dialog before sending any code to the AI provider. Disable if you want AI fixes to run without prompting."
        },
        "caspianSecurity.telemetryEndpoint": {
          "type": "string",
          "default": "https://telemetry.caspiansecurity.dev/v1/report",
          "description": "HTTPS endpoint that telemetry is sent to (only used when telemetry is enabled). Must start with https://. Change only if you are running your own aggregation endpoint."
        },
        "caspianSecurity.enablePersistentCache": {
          "type": "boolean",
          "default": true,
          "description": "Cache scan results and restore them on VS Code restart"
        },
        "caspianSecurity.skipUnchangedFiles": {
          "type": "boolean",
          "default": true,
          "description": "Skip re-scanning files that haven't changed since last scan during workspace scans"
        },
        "caspianSecurity.enableTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "Help improve Caspian Security by sharing anonymized rule effectiveness statistics. No code, file paths, or project data is ever sent."
        },
        "caspianSecurity.enableTaskManagement": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Security Task Management system with recurring task tracking and reminders"
        },
        "caspianSecurity.taskReminders": {
          "type": "boolean",
          "default": true,
          "description": "Show notification reminders when security tasks become overdue"
        },
        "caspianSecurity.enableTaintTracking": {
          "type": "boolean",
          "default": true,
          "description": "Enable intra-file taint tracking (TAINT001-TAINT008). Detects when user input flows into a dangerous sink within the same function. Bounded to 100ms per file."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "check-updates": "npm run compile && node out/cli/checkUpdates.js",
    "scan": "npm run compile && node out/cli/scan.js",
    "self-scan": "npm run compile && node out/cli/scan.js . --format text --fail-on error --exclude out,node_modules,.git,coverage",
    "scan-git-history": "npm run compile && node out/cli/gitHistoryScan.js",
    "mcp-server": "npm run compile && node out/cli/mcpServer.js",
    "publish:vscode": "vsce publish",
    "publish:openvsx": "ovsx publish",
    "publish:npm": "npm run compile && npm publish --access public"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^30.3.0",
    "ovsx": "^0.10.11",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
